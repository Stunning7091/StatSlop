<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="widget_background">@android:color/system_neutral1_50</color>
    <color name="widget_text">@android:color/system_neutral1_900</color>
    <color name="widget_text_secondary">@android:color/system_neutral2_700</color>

    <string name="widget_description">Battery, power, RAM and temperature with 24-hour graphs</string>
    <string name="widget_collecting">Graphs appear after about 30 minutes of history.</string>
    <string name="widget_battery_label">Battery · 24 h</string>
    <string name="widget_ram_label">RAM · 24 h</string>

    <style name="WidgetValue">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:maxLines">1</item>
        <item name="android:textColor">@color/widget_text</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="WidgetLabel">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:maxLines">1</item>
        <item name="android:textColor">@color/widget_text_secondary</item>
        <item name="android:textSize">11sp</item>
    </style>

    <style name="WidgetChart">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">0dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:scaleType">fitXY</item>
        <item name="android:importantForAccessibility">no</item>
    </style>
</resources>
